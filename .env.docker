# === DOCKER RUNTIME ONLY ===
# This file is the single source of truth for docker compose.
# Do NOT reuse .env.local here.

NODE_ENV=development
PORT=3000

# --- Postgres (container init vars) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_19_CHARS_OR_WHATEVER_YOU_WANT
POSTGRES_DB=ozaibot

# --- App DB vars (must match Postgres) ---
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME_19_CHARS_OR_WHATEVER_YOU_WANT
DB_DATABASE=ozaibot

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Admin ---
ADMIN_API_KEY=CHANGE_ME

# Optional (if you want to avoid EADDRINUSE without stopping local dev)
# APP_PORT=3001
