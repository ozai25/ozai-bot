# --- APPLICATION ---
NODE_ENV=production
PORT=3000
CORS_ORIGIN=*
# Default tenant for initial sync jobs
DEFAULT_TENANT_SLUG=oz01
LOG_LEVEL=info

# --- DATABASE (PostgreSQL) ---
# Railway provides DATABASE_URL, but TypeORM config prefers split parts usually.
# However, for Railway, we often just map DATABASE_URL in code if available.
# Your current config uses split vars. Map these in Railway!
DB_HOST=containers-us-west-123.railway.app
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_DATABASE=railway
DB_SSL=false

# --- REDIS ---
REDIS_HOST=
REDIS_PORT=6379
REDIS_DB=0
# If your Redis requires a user/pass (Railway Redis usually does):
REDIS_PASSWORD=

# --- SECURITY & TOKENS ---
ADMIN_API_KEY=change_me_to_something_strong_uuid_v4
DEV_ONLY_KEY=
EXPORT_TOKEN=

# --- AI PROVIDERS ---
# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# --- TENANT: SG01 (Shine & Go) ---
SG01_WA_PHONE_NUMBER_ID=
SG01_WA_ACCESS_TOKEN=
SG01_WA_VERIFY_TOKEN=
SG01_WA_APP_SECRET=

# --- TENANT: FP02 (Furniture Plus) ---
FP02_WA_PHONE_NUMBER_ID=
FP02_WA_ACCESS_TOKEN=
FP02_WA_VERIFY_TOKEN=
FP02_WA_APP_SECRET=

# --- TELEGRAM ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=